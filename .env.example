# EduMaster Tuition Management Portal - Environment Configuration

# Server Port (Cloud platforms like Render/Railway automatically assign this)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# JWT Authentication Secret Key (Generate a random 64-character secret in production)
JWT_SECRET=edumaster_production_secure_jwt_secret_key_2026_xyz987

# Allowed Frontend Origins for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000

# Optional External API Base URL (leave empty if frontend & backend are served together)
# VITE_API_URL=https://your-backend-api.onrender.com
